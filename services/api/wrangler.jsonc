{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "etchess-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "etchess-d1",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS_BUCKET",
      "bucket_name": "etchess-avatars"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_SESSION_DO",
        "class_name": "GameSessionDO"
      },
      {
        "name": "MATCHMAKER_DO",
        "class_name": "MatchmakerDO"
      },
      {
        "name": "USER_PRESENCE_DO",
        "class_name": "UserPresenceDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameSessionDO",
        "MatchmakerDO",
        "UserPresenceDO"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "development",
    "BETTER_AUTH_URL": "http://localhost:3000",
    "GOOGLE_CLIENT_ID": "471436113446-phn41bqcuuh2houq9mebb7hp0lhslvpf.apps.googleusercontent.com",
    "GITHUB_CLIENT_ID": "Ov23lijIriCE1INfTn73"
  },
  "env": {
    "staging": {
      "name": "etchess-api-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "etchess-d1-staging",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "AVATARS_BUCKET",
          "bucket_name": "etchess-avatars-staging"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME_SESSION_DO",
            "class_name": "GameSessionDO"
          },
          {
            "name": "MATCHMAKER_DO",
            "class_name": "MatchmakerDO"
          },
          {
            "name": "USER_PRESENCE_DO",
            "class_name": "UserPresenceDO"
          }
        ]
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "BETTER_AUTH_URL": "https://staging-api.etchess.io",
        "GOOGLE_CLIENT_ID": "471436113446-phn41bqcuuh2houq9mebb7hp0lhslvpf.apps.googleusercontent.com"
      }
    },
    "production": {
      "name": "etchess-api-production",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "etchess-d1-production",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "AVATARS_BUCKET",
          "bucket_name": "etchess-avatars-production"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME_SESSION_DO",
            "class_name": "GameSessionDO"
          },
          {
            "name": "MATCHMAKER_DO",
            "class_name": "MatchmakerDO"
          },
          {
            "name": "USER_PRESENCE_DO",
            "class_name": "UserPresenceDO"
          }
        ]
      },
      "vars": {
        "ENVIRONMENT": "production",
        "BETTER_AUTH_URL": "https://api.etchess.io",
        "GOOGLE_CLIENT_ID": "471436113446-phn41bqcuuh2houq9mebb7hp0lhslvpf.apps.googleusercontent.com"
      }
    }
  }
}
