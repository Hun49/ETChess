{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "etchess-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "etchess-d1",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_SESSION_DO",
        "class_name": "GameSessionDO"
      },
      {
        "name": "MATCHMAKER_DO",
        "class_name": "MatchmakerDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameSessionDO",
        "MatchmakerDO"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "development",
    "BETTER_AUTH_URL": "http://localhost:8787",
    "GOOGLE_CLIENT_ID": "471436113446-phn41bqcuuh2houq9mebb7hp0lhslvpf.apps.googleusercontent.com"
  },
  "env": {
    "staging": {
      "name": "etchess-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "BETTER_AUTH_URL": "https://staging-api.etchess.io"
      }
    },
    "production": {
      "name": "etchess-api-production",
      "vars": {
        "ENVIRONMENT": "production",
        "BETTER_AUTH_URL": "https://api.etchess.io"
      }
    }
  }
}
