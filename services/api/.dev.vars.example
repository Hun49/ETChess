# ET Chess Local Development Environment Configuration
# Copy this file to .dev.vars for local development:
# cp .dev.vars.example .dev.vars

BETTER_AUTH_SECRET=local_development_better_auth_secret_minimum_32_characters_long
WS_TICKET_SECRET=local_development_ws_ticket_secret_minimum_32_characters_long
BETTER_AUTH_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8787,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:8787,http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
