{
  "name": "@etchess/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply etchess-d1 --local"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.2.0",
    "@etchess/chess-core": "workspace:*",
    "@etchess/rating": "workspace:*",
    "@etchess/realtime-protocol": "workspace:*",
    "@etchess/types": "workspace:*",
    "@hono/zod-validator": "^0.4.3",
    "better-auth": "^1.2.0",
    "drizzle-orm": "^0.40.0",
    "hono": "^4.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@cloudflare/workers-types": "^4.20250224.0",
    "@etchess/config": "workspace:*",
    "drizzle-kit": "^0.30.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  }
}
