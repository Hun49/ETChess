{
  "name": "@etchess/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply etchess-d1 --local"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.2.0",
    "@etchess/chess-core": "workspace:*",
    "@etchess/rating": "workspace:*",
    "@etchess/realtime-protocol": "workspace:*",
    "@etchess/types": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261009.1",
    "@etchess/config": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
